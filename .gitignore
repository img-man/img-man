# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Boundary rule: this repo is the public `img-man` / ImageMan core. It should
# contain the self-hostable product, npm package sources, extension contracts,
# and templates only. Real env files, hosted-service deployment config, and
# private white-label/service overlays belong outside this repo.

# dependencies / package managers
/node_modules
/.pnp
.pnp.*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# framework/build/cache outputs
/.next/
/out/
/build
/dist
/packages/*/dist/
.turbo/
.cache/
.eslintcache
*.tsbuildinfo
next-env.d.ts

# npm package artifacts
*.tgz
*.tar.gz

# testing and reports
/coverage
/test-results/
/playwright-report/
/playwright/.auth/
/.playwright-mcp/
*.lcov
junit.xml

# local runtime data
/.tmp/
/tmp/
/temp/
/data/
*.pid
*.seed
*.pid.lock
build-output.txt

# debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: customers/operators supply these locally; only examples are tracked
.env
.env.*
!.env.example
!.env*.example

# credentials and deployment config - never commit real secrets to public core
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*service-account*.json
*gcp-service-account*.json
*credentials*.json
keys.json
gcloud.json
/secrets/
/extra/
app.yaml

# hosted/private repo boundary: Image-man service and white-label code lives in
# the private repo, which consumes this repo via subtree/clone and overlays.
/image-man-service/
/imageman-service/
/img-man-service/
/private/
/_private/
/enterprise/
/ee/
/upstream/
/overlay/
/overlays/
/white-label/
/whitelabel/
/white-sourcing/
/brand-kits/
/customer-templates/
/apps/landing/
/apps/cloud-console/
/apps/white-label-demo/
/packages/imageman-whitelabel/
/packages/imageman-cloud-support/
/packages/imageman-enterprise/
/packages/premium-templates/

# hosting provider local state
.vercel

# editor / OS local state
.DS_Store
/.vscode/
.idea/
.zed/
*.code-workspace
.history/
tmpclaude*

# generated release/evidence artifacts
sbom.cdx.json
eval-results.json
migration-stress-results.json
mcp-publish-eval-results.json
roadmap-blockers.json

# security scan reports contain partial secret values
gitleaks-report*.json
trufflehog-report*.json


agentDocs/
