{
  "name": "img-man",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "The open-source media operating system: asset management, design, PDF tools, AI, and delivery in one self-hosted stack.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "npm run build && node --test \"tests/e2e/**/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/**/*.test.mjs\"",
    "verify:public-purity": "node scripts/verify-public-purity.mjs",
    "self-host:bootstrap": "node scripts/self-host-bootstrap.mjs",
    "self-host:bootstrap:stdout": "node scripts/self-host-bootstrap.mjs --stdout",
    "subtree:init-private": "bash scripts/subtree-init-private-repo.sh"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "mongodb": "^6.21.0",
    "next": "^16.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
