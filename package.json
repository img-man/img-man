{
  "name": "img-man",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The open-source media operating system: asset management, design, PDF tools, AI, and delivery in one self-hosted stack.",
  "homepage": "https://github.com/img-man/img-man#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/img-man/img-man.git"
  },
  "bugs": {
    "url": "https://github.com/img-man/img-man/issues"
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "type-check": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke:auth": "node --experimental-strip-types scripts/smoke-authenticated-api.ts",
    "verify:public-purity": "node --experimental-strip-types scripts/verify-public-purity.ts",
    "verify:spdx": "node --experimental-strip-types scripts/verify-spdx.ts",
    "sbom": "node --experimental-strip-types scripts/generate-sbom.ts",
    "self-host:bootstrap": "node --experimental-strip-types scripts/self-host-bootstrap.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.1",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@google-cloud/storage": "^7.18.0",
    "@google-cloud/vertexai": "^1.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.4",
    "exceljs": "^4.4.0",
    "fabric": "^7.2.0",
    "framer-motion": "^12.34.3",
    "google-auth-library": "^10.6.1",
    "highlight.js": "^11.11.1",
    "jose": "^6.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "mongodb": "^6.21.0",
    "mongoose": "^9.1.6",
    "next": "^16.2.4",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "workspaces": [
    "packages/*"
  ]
}
