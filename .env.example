# img-man environment variables
# Copy this file to .env.local or .env.self-host and fill only what you need.

# Core app URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
PORT="3000"
IMAGEMAN_PORT="3000"

# Database
MONGODB_URI="mongodb://localhost:27017/imageman"
MONGODB_DB="imageman"

# Auth / signing
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
ASSET_URL_SIGNING_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"

# Default storage provider bootstrap (optional)
GCP_PROJECT_ID=""
GCP_STORAGE_BUCKET=""
GCP_APP_CREDENTIALS_PATH=""

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# Default AI provider bootstrap (optional)
DEFAULT_AI_PROVIDER="vertex"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional managed account unlock
IMAGEMAN_ACCOUNT_KEY=""
IMAGEMAN_ACCOUNT_API_URL="https://account.img-man.com"
IMAGEMAN_INSTANCE_ID=""
