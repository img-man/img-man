# ImageMan Environment Variables
# Copy this file to .env.local and fill in the values you actually need.
# Most values can be left blank for early local development; production
# deployments must set the marked (REQUIRED) variables.

# ─────────────────────────────────────────────────────────────────────────
# Core (REQUIRED in production)
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# Database (MongoDB) — REQUIRED.
# If MONGODB_URI is missing or blank, /api/health/ready returns 503 and
# data-backed routes fail. Keep this populated in every deploy environment.
MONGODB_URI="mongodb://localhost:27017/imageman"
MONGODB_DB="img-man"

# Authentication (NextAuth.js) — REQUIRED
NEXTAUTH_URL="http://localhost:4000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# First-boot administrator.
# Leave both blank to use the documented defaults (admin@img-man.com /
# Admin@12345). Either way the account is created with a forced credential
# change: the dashboard will not open until you replace them. Set these
# explicitly if the instance is reachable from anywhere but localhost.
IMGMAN_BOOTSTRAP_EMAIL=""
IMGMAN_BOOTSTRAP_PASSWORD=""

# Credential-at-rest encryption (BYOC/BYOK).
# AES-256-GCM KEK derived from this value via SHA-256.
# REQUIRED in production. Falls back to NEXTAUTH_SECRET if unset.
# Rotation procedure: see customer-docs/credential-rotation.md
GCP_CREDENTIALS_ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# OAuth providers (optional)
# ─────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────
# Default storage provider (BYOC) — first-org-only convenience
# Per-org storage credentials are stored encrypted in MongoDB instead.
# ─────────────────────────────────────────────────────────────────────────

# GCP Cloud Storage
GCP_PROJECT_ID=""
GCP_STORAGE_BUCKET=""
GCS_BUCKET=""
GCP_SERVICE_ACCOUNT_JSON=""        # Inline service-account JSON
GCP_APP_CREDENTIALS_PATH=""        # Path to service-account JSON file (local dev)
GCP_CLIENT_EMAIL=""                # Optional alias for inline credentials
GCP_PRIVATE_KEY=""                 # Optional alias; use escaped newlines (\\n)
GCP_PRIVATE_KEY_ID=""              # Optional alias

# AWS S3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# ─────────────────────────────────────────────────────────────────────────
# Default AI provider (BYOK) — per-org keys are stored encrypted in MongoDB.
# Use these only for first-boot bootstrap or single-tenant deployments.
# ─────────────────────────────────────────────────────────────────────────
DEFAULT_AI_PROVIDER="vertex"        # vertex | openai | openrouter | groq

# Vertex AI (Google) — defaults the platform ships with
GCP_VERTEX_LOCATION="us-central1"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
GEMINI_API_KEY=""
GOOGLE_AI_API_KEY=""

# OpenAI
OPENAI_API_KEY=""

# OpenRouter (placeholder — see docs/AI_PROVIDERS.md)
OPENROUTER_API_KEY=""

# Groq (placeholder — see docs/AI_PROVIDERS.md)
GROQ_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# Optional integrations
# ─────────────────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""
GOOGLE_FONTS_API_KEY=""
NEXT_PUBLIC_POLOTNO_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# Platform-admin (private surface; do NOT expose to tenants)
# ─────────────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────
# Feature flags / runtime
# ─────────────────────────────────────────────────────────────────────────
ENABLE_ASSET_ANALYTICS="false"
NEXTAUTH_DEBUG="0"
PORT="4000"

# Set to "true" only if outbound calls to your storage or AI provider fail
# intermittently with ECONNRESET. Pins outbound connections to IPv4, which
# works around a broken IPv6 path. Leave unset otherwise.
#IMGMAN_FORCE_IPV4="false"
